<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_conversation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:backgroundTint="#FAFAFD"
        android:layout_marginTop="8dp"
        app:cardCornerRadius="8dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.cardview.widget.CardView
                android:id="@+id/cv_src_languge"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_margin="8dp"
                app:cardCornerRadius="25sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/iv_src_img"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_flag_english" />
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/tv_src_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="The big brown dog runs."
                app:layout_constraintStart_toEndOf="@+id/cv_src_languge"
                app:layout_constraintEnd_toStartOf="@+id/img_is_favourate"
                app:layout_constraintTop_toTopOf="@+id/cv_src_languge"
                app:layout_constraintBottom_toBottomOf="@id/cv_src_languge"
                android:layout_margin="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="20sp"
                android:textColor="#6E6E6F"/>

            <androidx.cardview.widget.CardView
                android:id="@+id/cv_dest_languge"
                android:layout_width="50dp"
                android:layout_height="50dp"
                app:cardCornerRadius="25sp"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="8dp"
                android:layout_marginTop="8dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cv_src_languge"
                app:layout_constraintBottom_toBottomOf="parent">
                <ImageView
                    android:id="@+id/iv_dest_img"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_flag_spanish" />
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/tv_dest_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toEndOf="@+id/cv_dest_languge"
                app:layout_constraintEnd_toStartOf="@+id/img_is_favourate"
                app:layout_constraintTop_toTopOf="@+id/cv_dest_languge"
                app:layout_constraintBottom_toBottomOf="@id/cv_dest_languge"
                android:layout_margin="8dp"
                android:text="El perro marrón grande corre."
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="18sp"/>

                <ImageView
                    android:id="@+id/img_is_favourate"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_star_filled"
                    android:layout_marginEnd="8dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"

                    />
        </androidx.constraintlayout.widget.ConstraintLayout>


    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>