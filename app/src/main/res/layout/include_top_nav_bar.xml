<?xml version="1.0" encoding="utf-8"?>
<GridLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_column="5"
    android:layout_row="2">


    <ImageButton
        android:id="@+id/nav_home"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_column="0"
        android:layout_row="0"
        android:layout_columnWeight="1"
        app:tint="@color/white"
        android:background="#5C5CFF"
        android:src="@drawable/ic_translate_icon"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="8dp"
        android:layout_column="0"
        android:layout_row="1"
        android:layout_columnWeight="1"
        app:tint="@color/white"
        android:background="#5C5CFF"
        >
        <View
            android:id="@+id/nav_home_bar"
            android:layout_width="0dp"
            android:layout_height="4dp"
            app:tint="@color/white"
            android:background="#5C5CFF"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:layout_marginBottom="0dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageButton
        android:id="@+id/nav_conversation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_column="1"
        android:layout_row="0"
        android:layout_columnWeight="1"
        app:tint="@color/white"
        android:background="#5C5CFF"
        android:src="@drawable/ic_mic"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="8dp"
        android:layout_column="1"
        android:layout_row="1"
        android:layout_columnWeight="1"
        app:tint="@color/white"
        android:background="#5C5CFF"
        >
    <View
        android:id="@+id/nav_conversation_bar"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        app:tint="@color/white"
        android:background="#5C5CFF"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="5dp"
        android:layout_marginBottom="0dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>

    <ImageButton
        android:id="@+id/nav_history"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_column="2"
        android:layout_row="0"
        android:layout_columnWeight="1"
        app:tint="@color/white"
        android:background="#5C5CFF"
        android:src="@drawable/ic_history"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="8dp"
        android:layout_column="2"
        android:layout_row="1"
        android:layout_columnWeight="1"
        app:tint="@color/white"
        android:background="#5C5CFF"
        >
    <View
        android:id="@+id/nav_history_bar"
        android:layout_width="0dp"
        android:layout_height="4dp"
        app:tint="@color/white"
        android:background="#5C5CFF"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="5dp"
        android:layout_marginBottom="0dp"
        />
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageButton
        android:id="@+id/nav_favourate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_column="3"
        android:layout_row="0"
        android:layout_columnWeight="1"
        app:tint="@color/white"
        android:background="#5C5CFF"
        android:src="@drawable/ic_star"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="8dp"
        android:layout_column="3"
        android:layout_row="1"
        android:layout_columnWeight="1"
        app:tint="@color/white"
        android:background="#5C5CFF"
        >

    <View
        android:id="@+id/nav_favourate_bar"
        android:layout_width="0dp"
        android:layout_height="4dp"
        app:tint="@color/white"
        android:background="#5C5CFF"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="5dp"
        android:layout_marginBottom="0dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

</GridLayout>